{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "github>h3nc4/deps-branch-action"],
  "reviewers": ["h3nc4"],
  "assignAutomerge": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "description": "Auto-merge all minor, patch, pin, and digest updates",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "addLabels": ["automerge"],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "description": "Update Tor version in Dockerfile",
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG TOR_VERSION=\"(?<currentValue>.*?)\""],
      "datasourceTemplate": "git-tags",
      "depNameTemplate": "tor",
      "packageNameTemplate": "https://gitlab.torproject.org/tpo/core/tor.git",
      "extractVersionTemplate": "^tor-(?<version>\\d+\\.\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "loose"
    }
  ]
}
